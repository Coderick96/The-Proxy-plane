# Merge with your existing server/account/billing configuration; see PREMIUM_SETUP.md.
LOCAL_ART_ENABLED=true
# Run npm run local-art:keys once. Keep the private key on the hosted server ONLY.
LOCAL_ART_PRIVATE_KEY_FILE=.local-art-keys/private.pem
CLIENT_ORIGIN=http://127.0.0.1:5173
# Renderer environment, or export these on the user's computer:
PP_APP_ORIGIN=http://127.0.0.1:5173
# PP_ART_PUBLIC_KEY_FILE=/path/to/publisher-public.pem
