# Nonsecret setup template for an isolated private-beta backend.
# Copy to the untracked repository-root .env; fill real credentials securely.
# Never use the existing real-data project for setup/fixture operations.
BETA_MODE=true
VITE_PRIVATE_BETA=true
BETA_AI_ENABLED=false
BETA_TEST_BILLING=false

# SAME isolated Supabase project's URL and public publishable/anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Server secret/service-role key: never prefix with VITE_ or put in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Confirmed Auth user UUID, not an email address.
OWNER_USER_ID=

# Local development defaults. Use your exact HTTPS origin when hosting.
CLIENT_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8787
SERVE_WEB=false

# Optional owner-only development/Preview wallet refill. Off until reviewed.
DEV_CREDIT_TOPOFF_ENABLED=false
DEV_CREDIT_TOPOFF_AMOUNT=100
OWNER_TOPOFF_CODE=

# Optional cloud AI. Device inference does not need these; both need account credits.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_SAFETY_MODEL=gpt-4.1-mini

# Optional Stripe TEST-mode billing. Never supply live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_STUDIO_PASS=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_30=
STRIPE_PRICE_CREDITS_80=
STRIPE_PRICE_PACK_CELESTIAL=
STRIPE_PRICE_PACK_GOTHIC=
STRIPE_PRICE_PACK_DRAGON=

# Serverless cloud recovery: configure a real scheduler and verify its execution first.
CRON_SECRET=
AI_RECOVERY_SCHEDULER_VERIFIED=false

# Enable only after each OAuth provider is configured in this Supabase project.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_APPLE_AUTH_ENABLED=false
# Existing server-only legacy variable supabase is accepted only for a service credential.

# Enable only after the cloud provider key and recovery scheduler are verified.
VITE_CLOUD_ART_ENABLED=false
